# Kho-Kho OCR Pipeline Configuration

# ── Database Configuration ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/kho_kho_db

# ── Tesseract OCR Configuration ─────────────────────────────────────────────
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac example:
# TESSERACT_PATH=/usr/bin/tesseract

# ── Extraction Performance Configuration ────────────────────────────────────
# Extraction mode: 'standard' (original) or 'optimized' (recommended)
# - optimized: 60-75% faster with parallel processing and caching
# - standard: Original implementation for compatibility
EXTRACTION_MODE=optimized

# Fast preprocessing mode: true or false
# - true: Skip deskew and morphology for maximum speed (~40-60% faster)
# - false: Full preprocessing for maximum accuracy (default)
# Use true when documents are well-aligned and speed is priority
FAST_MODE=false

# Enable parallel region extraction: true or false  
# - true: Use threading for 3-4x faster OCR calls (default)
# - false: Sequential extraction (useful for debugging)
USE_THREADING=true

# ── Logging Configuration ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# ── Django Configuration ────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-insecure-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.example.com

# ── CORS Configuration ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email Configuration (Optional) ──────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# ── Max File Upload Size ────────────────────────────────────────────────────
# Maximum image file size in MB (default: 20MB)
MAX_UPLOAD_SIZE_MB=20

# ── Performance Tuning ──────────────────────────────────────────────────────
# Number of OCR extraction threads (1-8, depends on CPU cores)
# Auto-detected; only set if needed
# OCR_MAX_WORKERS=4

# ── Cache Configuration ────────────────────────────────────────────────────
# Maximum OCR cache entries (default: 1000)
# Increase for high-volume processing, decrease for low-memory systems
# OCR_CACHE_MAX_SIZE=1000
